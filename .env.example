# =====================================================================
# AI-Powered Integrated Bid Compliance Verification Platform for GeM
# Global Environment Variables Configuration Template (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# Backend Configuration
# ---------------------------------------------------------------------
PROJECT_NAME="GeM Bid Compliance Platform"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Connection (PostgreSQL or SQLite fallback)
# For Docker Compose: postgresql://postgres:postgres_password@db:5432/bid_compliance_db
DATABASE_URL=sqlite:///./bid_compliance.db

# Security & Authentication
SECRET_KEY=change_this_super_secret_jwt_key_for_production_use_sih2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI Service
GEMINI_API_KEY=your_gemini_api_key_here

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# File Storage Directory
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------
# Frontend Configuration (Vite)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
# Groq (recommended for this setup)
# AI provider configuration for the GeMmy chatbot.
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WEB_SEARCH_ENABLED=true
GROQ_WEB_MODEL=groq/compound-mini

# ---------------------------------------------------------------------
# Direct GeM API Integration (Production Mode)
# ---------------------------------------------------------------------
GEM_BASE_URL=https://api.gem.gov.in/v1
GEM_CLIENT_ID=your_gem_client_id_here
GEM_CLIENT_CERT=certs/gem_client_cert.pem
GEM_CLIENT_KEY=certs/gem_client_key.pem
GEM_USE_MOCK=true
