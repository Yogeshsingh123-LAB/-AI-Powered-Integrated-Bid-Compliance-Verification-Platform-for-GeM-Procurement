# Copy this file to backend/.env for local development; use host secrets in production.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/bid_compliance_db
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@gem.gov.in
INITIAL_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=bid-documents
UPLOAD_DIR=storage/uploads
# Verification Gateway Configuration (Hybrid Live / Simulated Adapters)
MCA_GATEWAY_MODE=live        # 'live' (queries data.gov.in MCA21 dataset) or 'mock'
GSTN_GATEWAY_MODE=mock       # 'mock' (simulated adapter; swap to Sandbox.co.in / Setu in production)
PAN_GATEWAY_MODE=mock        # 'mock'
EPFO_GATEWAY_MODE=mock       # 'mock'
ESIC_GATEWAY_MODE=mock       # 'mock'
DIGILOCKER_GATEWAY_MODE=mock # 'mock'
DATA_GOV_IN_API_KEY=

GEM_USE_MOCK=true
ENABLE_REAL_API_LOOKUP=false
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Security / processing (hardened defaults; see README "Security Posture") ----
SESSION_COOKIE_NAME=gem_token
SESSION_COOKIE_SECURE=true            # keep true on any https deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Document processing strategy:
#   true  - process inside the API process. On Vercel (serverless) the pipeline
#           runs synchronously within the 300s function budget (recommended).
#   false - leave uploads UPLOADED for a durable worker (backend/worker.py)
#           on a long-lived host.
INLINE_PROCESSING=true
WORKER_POLL_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_STUCK_MINUTES=20

# Upload limits (server-enforced)
MAX_UPLOAD_MB=10
MAX_UPLOAD_PAGES=300
MAX_FILENAME_LENGTH=200

# Optional ClamAV malware scan, e.g. "localhost:3310". Empty disables scanning.
# When set, uploads FAIL CLOSED (503) if ClamAV is unreachable.
CLAMAV_SOCKET=

# Development-only flags (leave false; /auth/seed is never mounted in production)
SEED_DEMO_ACCOUNTS=false
ALLOW_SEED_ENDPOINT=false

# Login rate limiting / lockout (server-side)
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15
