# Copy this file to backend/.env for local development; use host secrets in production.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/bid_compliance_db
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@gem.gov.in
INITIAL_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=bid-documents
UPLOAD_DIR=storage/uploads
# Verification Gateway Configuration (Hybrid Live / Simulated Adapters)
MCA_GATEWAY_MODE=live        # 'live' (queries data.gov.in MCA21 dataset) or 'mock'
GSTN_GATEWAY_MODE=mock       # 'mock' (simulated adapter; swap to Sandbox.co.in / Setu in production)
PAN_GATEWAY_MODE=mock        # 'mock'
EPFO_GATEWAY_MODE=mock       # 'mock'
ESIC_GATEWAY_MODE=mock       # 'mock'
DIGILOCKER_GATEWAY_MODE=mock # 'mock'
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdd3946968444ef77000e0461fb3a123

GEM_USE_MOCK=true
ENABLE_REAL_API_LOOKUP=false
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

