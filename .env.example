# Copy to .env for Docker Compose. For local Python use backend/.env.example.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/bid_compliance_db
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
INITIAL_ADMIN_EMAIL=admin@gem.gov.in
INITIAL_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=bid-documents
UPLOAD_DIR=storage/uploads
# These registry integrations remain demonstrations until real API access is configured.
GEM_USE_MOCK=true
ENABLE_REAL_API_LOOKUP=false
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

POSTGRES_PASSWORD=replace-with-a-strong-database-password
